# ─────────────────────────────────────────────────────────────────────────────
# Frontend Environment Variables (Vite)
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# Leave EMPTY for local development (Vite proxy will forward /api to localhost:5000)
# In production (Vercel), set this to your Render backend URL:
# Example: VITE_API_URL=https://ai-study-helper-api.onrender.com
VITE_API_URL=
