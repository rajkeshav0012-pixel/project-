# ─────────────────────────────────────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (get from mongodb.com/atlas — free M0 cluster)
# Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/ai-study-helper
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/ai-study-helper

# JWT signing secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Google Gemini API key — get free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (Render sets this automatically)
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
# In production: set this to your Vercel URL, e.g. https://ai-study-helper.vercel.app
# In dev: leave empty or set to http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
